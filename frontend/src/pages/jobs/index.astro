---
import { getCollection, markdown } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetaList from '../../components/ui/MetaList.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import { withBase } from '../../lib/withBase';

const jobs = (await getCollection('jobs'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((job) => job.data.status === 'aktiv');

const singleJob = jobs.length === 1 ? jobs[0] : null;
const singleJobRender = singleJob ? { html: markdown(singleJob.body) } : null;
---

<BaseLayout
  title="Jobs in Tragwerksplanung und Baudynamik | Tappauf ZT"
  description="Aktuelle Jobs in Tragwerksplanung, Baudynamik und konstruktivem Ingenieurbau bei Tappauf ZT in Graz."
>
  <main id="top" class="hx hx-sub">
    <div class="hx-wrap">
      <PageIntro eyebrow="Jobs" title="Offene Positionen." text="Aktuelle Einstiegsmöglichkeiten für Tragwerksplanung, Baudynamik und konstruktiven Ingenieurbau in Graz." />

      {jobs.length === 1 && singleJob && singleJobRender ? (
        <section class="hx-detail">
          <MetaList
            title="Rahmendaten"
            items={[
              { label: 'Status', value: singleJob.data.status },
              { label: 'Standort', value: singleJob.data.location },
              { label: 'Arbeitszeit', value: singleJob.data.workload },
              { label: 'Anstellungsart', value: singleJob.data.employmentType },
              { label: 'Bewerbung', value: singleJob.data.applyEmail, href: singleJob.data.applyEmail ? `mailto:${singleJob.data.applyEmail}` : undefined },
            ]}
          />
          <div>
            <h2 class="hx-h2">{singleJob.data.title}</h2>
            {singleJob.data.summary && <p class="hx-lead">{singleJob.data.summary}</p>}
            <div class="hx-article"><Fragment set:html={singleJobRender.html} /></div>
            {singleJob.data.applyEmail && <p class="hx-actions"><a class="hx-btn hx-btn--primary" href={`mailto:${singleJob.data.applyEmail}`}>Jetzt bewerben</a></p>}
          </div>
        </section>
      ) : (
        <ul class="hx-rows hx-rows--stack">
          {jobs.map((job) => (
            <li>
              <a href={withBase(`/jobs/${job.id}`)} class="hx-row hx-row--job">
                <span class="hx-row__n">{job.data.status}</span>
                <span class="hx-row__main">
                  <span class="hx-row__title">{job.data.title}</span>
                  {job.data.summary && <span class="hx-row__text">{job.data.summary}</span>}
                </span>
                <span class="hx-row__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</BaseLayout>
