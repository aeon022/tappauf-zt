---
import Image from '../../components/ui/Img.astro';
interface Props { team: any[]; dark?: boolean; roomy?: boolean }
const { team } = Astro.props;
const phoneHref = (p: string) => `tel:${p.replace(/[^+\d]/g, '')}`;
---
<ul class="hx-team">
  {team.map((m) => (
    <li class="hx-member">
      {m.data.image && <div class="hx-member__img"><Image src={m.data.image} alt={m.data.name} widths={[360, 540, 720]} sizes="(min-width: 1024px) 18vw, 40vw" loading="lazy" decoding="async" /></div>}
      <div>
        <h2 class="hx-h3">{m.data.name}</h2>
        <p class="hx-member__role">{m.data.role}</p>
        {m.data.qualification && <p class="hx-member__text">{m.data.qualification}</p>}
        <p class="hx-member__contact">
          {m.data.phone && <a href={phoneHref(m.data.phone)}>{m.data.phone}</a>}
          {m.data.email && <a href={`mailto:${m.data.email}`}>{m.data.email}</a>}
        </p>
      </div>
    </li>
  ))}
</ul>
