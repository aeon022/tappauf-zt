---
import { getCollection } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReferenceCard from '../../components/blocks/ReferenceCard.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import { withBase } from '../../lib/withBase';

const allProjects = await getCollection('references');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
const seoBase = Astro.site ?? Astro.url;
const categoryLabels = {
  alle: 'Alle',
  hochbau: 'Hochbau',
  tiefbau: 'Tiefbau',
  industrie: 'Industriebau',
  bruecken: 'Brueckenbau',
  sonderprojekte: 'Sonderprojekte',
} as const;
const filterOptions = Object.entries(categoryLabels).map(([value, label]) => ({
  value,
  label,
  count: value === 'alle' ? sortedProjects.length : sortedProjects.filter((project) => project.data.category === value).length,
}));
const commandPaletteShortcut = 'Strg + K';
const referencesPageUrl = new URL(withBase('/projekte'), seoBase).toString();
const referenceFiltersScriptTag = `<script type="module">import ${JSON.stringify(withBase('/scripts/reference-filters.js'))};<\/script>`;
---

<BaseLayout
  title="Referenzen im Hochbau, Industriebau und Brueckenbau | Tappauf ZT"
  description="Ausgewaehlte Referenzen aus Hochbau, Industriebau, Brueckenbau und Spezialaufgaben mit Fokus auf Tragwerksplanung und Baudynamik."
  structuredData={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Referenzen',
      description: 'Ausgewaehlte Referenzen aus Hochbau, Industriebau, Brueckenbau und Spezialaufgaben mit Fokus auf Tragwerksplanung und Baudynamik.',
      url: referencesPageUrl,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'Referenzen',
      itemListElement: sortedProjects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: project.data.title,
        url: new URL(withBase(`/projekte/${project.id}`), seoBase).toString(),
      })),
    },
  ]}
>
  <main id="top" class="hx hx-sub references-index">
    <div class="hx-wrap">
      <PageIntro
        eyebrow="Portfolio"
        title="Referenzen"
        text="Ausgewählte Projekte aus Hochbau, Industriebau, Brückenbau und Sonderaufgaben mit Fokus auf Tragwerksplanung und Baudynamik."
      />

      <section class="hx-filter" data-reference-filter-root aria-label="Referenzen filtern">
        <label class="hx-search">
          <span class="hx-search__label">Suche</span>
          <input type="search" name="q" placeholder="Titel, Auftraggeber, Kategorie oder Jahr" autocomplete="off" spellcheck="false" data-reference-search-input />
        </label>
        <div class="hx-chips" role="group" aria-label="Fachbereich">
          {filterOptions.map((option) => (
            <button
              type="button"
              class:list={['hx-chip reference-filter-chip', option.value === 'alle' && 'reference-filter-chip--active']}
              data-reference-filter={option.value}
              aria-pressed={option.value === 'alle' ? 'true' : 'false'}
            >
              <span>{option.label}</span>
              <span class="hx-chip__n">{option.count}</span>
            </button>
          ))}
        </div>
        <p class="hx-filter__status" role="status" aria-live="polite">
          <span data-reference-filter-label>Alle</span>: <span data-reference-filter-count>{sortedProjects.length}</span> Projekte
        </p>
      </section>

      <div class="hx-refrows" data-reference-grid>
        {sortedProjects.map((project) => (
          <ReferenceCard project={project} />
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<Fragment set:html={referenceFiltersScriptTag} />
