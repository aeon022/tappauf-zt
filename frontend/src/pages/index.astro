---
import { getCollection, getEntry } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/blocks/ContactBlock.astro';
import Image from '../components/ui/Img.astro';
import { withBase } from '../lib/withBase';

const home = await getEntry('home', 'startseite');
const settings = await getEntry('settings', 'global');
const byOrder = (a: any, b: any) => a.data.order - b.data.order;
const services = (await getCollection('services')).sort(byOrder);
const team = (await getCollection('team')).sort(byOrder).slice(0, 4);
const references = (await getCollection('references')).sort(byOrder).slice(0, 8);
const partners = (await getCollection('partners')).sort(byOrder);
const d = home?.data ?? {};
const categoryLabels: Record<string, string> = { hochbau: 'Hochbau', tiefbau: 'Tiefbau', industrie: 'Industriebau', bruecken: 'Brückenbau', sonderprojekte: 'Sonderprojekte' };
const two = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title={`${settings?.data.siteTitle} | Tragwerksplanung und Baudynamik in Graz`}
  description={settings?.data.metaDescription}
  ogImage={d.heroImage}
>
  <main id="top" class="home">
    <!-- 1 · Hero -->
    <section class="hx hx-hero">
      <div class="hx-wrap hx-hero__grid">
        <div class="hx-hero__text">
          <p class="hx-label">{d.heroEyebrow}</p>
          <h1 class="hx-h1">{d.heroHeadline}</h1>
          <p class="hx-lead">{d.heroText}</p>
          <div class="hx-actions">
            <a class="hx-btn hx-btn--primary" href={withBase(d.heroSecondaryHref || '/projekte')}>Referenzen ansehen</a>
            <a class="hx-btn hx-btn--secondary" href={withBase('/kontakt')}>Kontakt aufnehmen</a>
          </div>
        </div>
        <figure class="hx-hero__photo">
          <Image src={d.heroImage} alt={d.heroImageAlt || ''} widths={[640, 960, 1240]} sizes="(min-width: 1024px) 56vw, 92vw" loading="eager" fetchpriority="high" decoding="async" />
        </figure>
      </div>
      <dl class="hx-wrap hx-facts">
        <div><dt>Erfahrung</dt><dd>über 30 Jahre</dd></div>
        <div><dt>Leistungsfelder</dt><dd>{services.length}</dd></div>
        <div><dt>Standort</dt><dd>Graz, weltweit tätig</dd></div>
        <div><dt>Versicherung</dt><dd>inkl. USA und Kanada</dd></div>
      </dl>
    </section>

    <!-- 2 · Profil -->
    <section class="hx hx-profile" id="profil">
      <div class="hx-wrap hx-split">
        <div>
          <p class="hx-label">{d.aboutTitle || 'Über uns'}</p>
          <h2 class="hx-h2">International erfahren, technisch präzise.</h2>
        </div>
        <div class="hx-prose">
          <p class="hx-lead hx-lead--ink">{d.aboutText}</p>
          <div class="hx-twocol">
            <div><h3 class="hx-h3">{d.approachTitle}</h3><p>{d.approachText}</p></div>
            <div><h3 class="hx-h3">{d.insuranceTitle}</h3><p>{d.insuranceText}</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · Leistungen -->
    <section class="hx hx-services" id="leistungen">
      <div class="hx-wrap">
        <div class="hx-head">
          <div>
            <p class="hx-label">Leistungen</p>
            <h2 class="hx-h2">Planung in klaren Leistungsbausteinen.</h2>
          </div>
          <a class="hx-link" href={withBase('/leistungen')}>Alle Leistungen</a>
        </div>
        <ol class="hx-rows">
          {services.map((s, i) => (
            <li>
              <a class="hx-row" href={withBase(`/leistungen/${s.id}`)}>
                <span class="hx-row__n">{two(i + 1)}</span>
                <span class="hx-row__main">
                  <span class="hx-row__title">{s.data.title}</span>
                  <span class="hx-row__text">{s.data.summary}</span>
                </span>
                {s.data.image && (
                  <span class="hx-row__img"><Image src={s.data.image} alt="" widths={[320, 480, 640]} sizes="240px" loading="lazy" decoding="async" /></span>
                )}
                <span class="hx-row__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4 · Referenzen -->
    <section class="hx hx-refs" id="referenzen">
      <div class="hx-wrap">
        <div class="hx-head">
          <div>
            <p class="hx-label">Referenzen</p>
            <h2 class="hx-h2">{d.referencesTitle}</h2>
          </div>
          <a class="hx-link" href={withBase('/projekte')}>Alle Referenzen</a>
        </div>
        <ul class="hx-ref-list">
          {references.map((r) => (
            <li>
              <a href={withBase(`/projekte/${r.id}`)} class="hx-ref">
                <span class="hx-ref__title">{r.data.title}</span>
                <span class="hx-ref__meta">{[r.data.details || r.data.client, categoryLabels[r.data.category] ?? r.data.category, r.data.year].filter(Boolean).join(' · ')}</span>
                <span class="hx-row__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5 · Partner -->
    <section class="hx hx-partners" id="partner">
      <div class="hx-wrap">
        <div class="hx-head">
          <div>
            <p class="hx-label">Netzwerk</p>
            <h2 class="hx-h2">{d.partnersTitle || 'Auftraggeber und Partner'}</h2>
          </div>
        </div>
        <ul class="hx-logos">
          {partners.map((p) => (
            <li>
              {p.data.website
                ? <a href={p.data.website} target="_blank" rel="noreferrer" aria-label={p.data.name}><Image src={p.data.logo} alt={p.data.name} widths={[200, 320]} sizes="160px" loading="lazy" decoding="async" /></a>
                : <Image src={p.data.logo} alt={p.data.name} widths={[200, 320]} sizes="160px" loading="lazy" decoding="async" />}
            </li>
          ))}
        </ul>
        <p class="hx-note">{d.partnersText}</p>
      </div>
    </section>

    <!-- 6 · Team -->
    <section class="hx hx-team" id="team">
      <div class="hx-wrap">
        <div class="hx-head">
          <div>
            <p class="hx-label">Team</p>
            <h2 class="hx-h2">Menschen mit Verantwortung.</h2>
          </div>
          <a class="hx-link" href={withBase('/team')}>Gesamtes Team</a>
        </div>
        <ul class="hx-people">
          {team.map((m) => (
            <li>
              {m.data.image && <div class="hx-people__img"><Image src={m.data.image} alt={m.data.name} widths={[360, 540, 720]} sizes="(min-width: 1024px) 22vw, 46vw" loading="lazy" decoding="async" /></div>}
              <h3 class="hx-h3">{m.data.name}</h3>
              <p class="hx-people__role">{m.data.role}</p>
              {m.data.email && <a class="hx-people__mail" href={`mailto:${m.data.email}`}>{m.data.email}</a>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <ContactBlock
      title={settings?.data.siteTitle || ''}
      description={settings?.data.siteDescription || ''}
      email={settings?.data.email || ''}
      phone={settings?.data.phone || ''}
      address={settings?.data.address || ''}
      mapEmbed={settings?.data.googleMapsEmbed || ''}
      mapLink={settings?.data.googleMapsLink || ''}
      companyDetails={settings?.data.companyDetails || ''}
    />
  </main>
</BaseLayout>
