---
import { getCollection, markdown } from '../../lib/content';
import Image from '../../components/ui/Img.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import { withBase } from '../../lib/withBase';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const html = markdown(entry.body);
const seoBase = Astro.site ?? Astro.url;
const serviceUrl = new URL(withBase(`/leistungen/${entry.id}`), seoBase).toString();
const contactUrl = new URL(withBase('/kontakt'), seoBase).toString();
const serviceStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(withBase('/'), seoBase).toString() },
      { '@type': 'ListItem', position: 2, name: 'Leistungen', item: new URL(withBase('/leistungen'), seoBase).toString() },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: serviceUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: entry.data.title,
    description: entry.data.summary,
    serviceType: entry.data.title,
    provider: {
      '@type': 'Organization',
      name: 'Tappauf ZT GmbH',
      areaServed: 'AT',
    },
    areaServed: 'AT',
    url: serviceUrl,
    image: entry.data.image?.src ? new URL(entry.data.image.src, seoBase).toString() : undefined,
    offers: {
      '@type': 'Offer',
      url: contactUrl,
    },
  },
];
---
<BaseLayout
  title={`${entry.data.title} | Tragwerksplanung | Tappauf ZT`}
  description={`${entry.data.title}: ${entry.data.summary}`}
  ogImage={entry.data.image}
  structuredData={serviceStructuredData}
>
  <main id="top" class="hx hx-sub">
    <div class="hx-wrap">
      <a class="hx-back" href={withBase('/leistungen')}><span aria-hidden="true">←</span> Alle Leistungen</a>
      <PageIntro eyebrow="Leistungsfeld" title={entry.data.title} text={entry.data.summary} />
      <div class="hx-detail hx-detail--wide">
        <div>
          {entry.data.image && <figure class="hx-figure"><Image src={entry.data.image} alt={entry.data.title} widths={[640, 960, 1200]} sizes="(min-width: 1024px) 56vw, 92vw" /></figure>}
          <h2 class="hx-h3">Leistungsbeschreibung</h2>
          <div class="hx-article"><Fragment set:html={html} /></div>
        </div>
        <aside class="hx-aside">
          <h2 class="hx-h3">Schwerpunkte</h2>
          <ol class="hx-numlist">
            {entry.data.items.map((item: string, index: number) => (<li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>))}
          </ol>
          <div class="hx-aside__cta">
            <h2 class="hx-h3">Nächster Schritt</h2>
            <p>Für Rückfragen zu diesem Leistungsfeld oder zur Projektanfrage stehen wir direkt zur Verfügung.</p>
            <a class="hx-btn hx-btn--primary" href={withBase('/kontakt')}>Kontakt aufnehmen</a>
          </div>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
