---
import Image from '../../components/ui/Img.astro';
import { withBase } from '../../lib/withBase';

interface Props { services: any[]; itemLimit?: number }
const { services, itemLimit } = Astro.props;
const two = (n: number) => String(n).padStart(2, '0');
---
<ol class="hx-rows hx-rows--stack">
  {services.map((service, i) => (
    <li>
      <article class="hx-svc">
        <span class="hx-row__n">{two(i + 1)}</span>
        <div class="hx-svc__body">
          <h2 class="hx-row__title"><a href={withBase(`/leistungen/${service.id}`)}>{service.data.title}</a></h2>
          <p class="hx-row__text">{service.data.summary}</p>
          {service.data.items?.length > 0 && (
            <ul class="hx-tags">
              {(typeof itemLimit === 'number' ? service.data.items.slice(0, itemLimit) : service.data.items).map((item: string) => <li>{item}</li>)}
            </ul>
          )}
          <a class="hx-link" href={withBase(`/leistungen/${service.id}`)}>Mehr zu {service.data.title}</a>
        </div>
        {service.data.image && (
          <div class="hx-svc__img"><Image src={service.data.image} alt="" widths={[480, 768, 960]} sizes="(min-width: 1024px) 36vw, 90vw" loading="lazy" decoding="async" /></div>
        )}
      </article>
    </li>
  ))}
</ol>
