---
interface Props { title: string; description: string; email: string; phone: string; address: string; mapEmbed: string; mapLink: string; companyDetails?: string; detailed?: boolean }
const { title, description, email, phone, address, mapEmbed, mapLink, companyDetails, detailed = false } = Astro.props;
const phoneHref = `tel:${phone.replace(/[^+\d]/g, '')}`;
---
<section class="hx hx-contact" id="kontakt">
  <div class="hx-wrap hx-contact__grid">
    <div>
      <p class="hx-label">Kontakt</p>
      <h2 class="hx-h2">{detailed ? 'So erreichen Sie uns.' : 'Sprechen wir über Ihr Tragwerk.'}</h2>
      <p class="hx-lead">{description}</p>
      <dl class="hx-contact__list">
        <div><dt>Telefon</dt><dd><a href={phoneHref}>{phone}</a></dd></div>
        <div><dt>E-Mail</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></div>
        <div><dt>Adresse</dt><dd class="hx-pre">{companyDetails || address}</dd></div>
      </dl>
    </div>
    <div class="hx-map" data-external-content>
      <div class="hx-map__ph contact-embed-placeholder" data-external-placeholder>
        <h3 class="hx-h3">Google Maps erst nach Zustimmung</h3>
        <p>Die Karte wird von Google geladen und kann personenbezogene Daten wie IP-Adresse und Nutzungsdaten verarbeiten.</p>
        <div class="hx-actions">
          <button type="button" class="hx-btn hx-btn--primary" data-cookie-enable-external>Google Maps erlauben</button>
          <a href={mapLink} target="_blank" rel="noreferrer" class="hx-btn hx-btn--secondary">In Google Maps öffnen<span class="sr-only"> (neuer Tab)</span></a>
        </div>
      </div>
      <iframe data-external-iframe data-src={mapEmbed} title={`Karte: ${title}`} class="hx-map__frame" loading="lazy" referrerpolicy="no-referrer-when-downgrade" hidden></iframe>
    </div>
  </div>
</section>
