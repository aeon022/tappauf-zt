---
interface Item { label: string; value?: string; href?: string }
interface Props { title: string; items: Item[]; inverse?: boolean }
const { title, items } = Astro.props;
const filtered = items.filter((item) => item.value);
---
<aside class="hx-meta" aria-label={title}>
  <h2 class="hx-h3">{title}</h2>
  <dl>
    {filtered.map((item) => (
      <div>
        <dt>{item.label}</dt>
        <dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
      </div>
    ))}
  </dl>
</aside>
