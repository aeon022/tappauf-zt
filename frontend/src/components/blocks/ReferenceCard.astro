---
import Image from '../../components/ui/Img.astro';
import { withBase } from '../../lib/withBase';
import { hasReferenceContent } from '../../lib/referenceContent';

const { project } = Astro.props;
const { title, details, category, year, client, heroImage } = project.data;
const hasDetails = hasReferenceContent(project.body);
const categoryLabels = { hochbau: 'Hochbau', tiefbau: 'Tiefbau', industrie: 'Industriebau', bruecken: 'Brückenbau', sonderprojekte: 'Sonderprojekte' } as const;
const categoryKey = (category ?? 'industrie') as keyof typeof categoryLabels;
const categoryLabel = categoryLabels[categoryKey] ?? category ?? '';
const detailHref = withBase(`/projekte/${project.id}`);
const searchableText = [title, details, client, categoryLabel, year ? String(year) : ''].filter(Boolean).join(' ').toLowerCase();
const meta = [client || details, categoryLabel, year].filter(Boolean).join(' · ');
---
<article
  class="hx-refrow"
  data-reference-card
  data-category={category}
  data-category-label={categoryLabel}
  data-title={title.toLowerCase()}
  data-client={(client || '').toLowerCase()}
  data-details={(details || '').toLowerCase()}
  data-year={year ? String(year) : ''}
  data-href={hasDetails ? detailHref : ''}
  data-search={searchableText}
>
  {heroImage && <div class="hx-refrow__img"><Image src={heroImage} alt="" widths={[320, 480, 640]} sizes="12rem" loading="lazy" decoding="async" /></div>}
  <div class="hx-refrow__main">
    <h2 class="hx-row__title">{hasDetails ? <a href={detailHref}>{title}</a> : title}</h2>
    <p class="hx-row__text">{meta}</p>
  </div>
  {hasDetails && <a class="hx-row__go" href={detailHref} aria-label={`${title}: Details ansehen`}>→</a>}
</article>
