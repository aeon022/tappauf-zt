---
interface Props { publications: any[]; limit?: number }
const { publications, limit } = Astro.props;
const items = typeof limit === 'number' ? publications.slice(0, limit) : publications;
---
<ol class="hx-rows hx-rows--stack">
  {items.map((p) => {
    const href = p.data.pdfFile?.url ?? p.data.pdfUrl;
    return (
      <li>
        <article class="hx-pub">
          <span class="hx-row__n">{p.data.year}</span>
          <div>
            <h2 class="hx-row__title">{p.data.title}</h2>
            <p class="hx-row__text">{p.data.citation}</p>
            {href && <a class="hx-link" href={href} target="_blank" rel="noreferrer">PDF öffnen<span class="sr-only"> (öffnet in neuem Tab)</span></a>}
          </div>
        </article>
      </li>
    );
  })}
</ol>
